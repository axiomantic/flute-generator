{
  "dependencies": {
    "openscad-wasm": "^0.0.4",
    "puppeteer": "^25.8.0"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/three": "^0.185.4",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "name": "flute-generator",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:docs": "node scripts/build.mjs --docs",
    "build:examples": "node scripts/build.mjs && node scripts/build_examples.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "serve": "node scripts/serve.mjs . 8000",
    "serve:docs": "node scripts/serve.mjs docs 8001",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:sweep": "vitest run test/solver-invariants.test.ts test/geometry.test.ts",
    "test:coverage": "vitest run --coverage.enabled --coverage.provider=v8 --coverage.include='src/web/**' --coverage.reporter=text"
  }
}
